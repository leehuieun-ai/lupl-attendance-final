VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Edge Function secrets for NAVER WORKS KPI messages
# Set these in Supabase Dashboard > Edge Functions > Secrets, not in the browser app.
NAVER_WORKS_CLIENT_ID=YOUR_NAVER_WORKS_CLIENT_ID
NAVER_WORKS_CLIENT_SECRET=YOUR_NAVER_WORKS_CLIENT_SECRET
NAVER_WORKS_SERVICE_ACCOUNT=YOUR_NAVER_WORKS_SERVICE_ACCOUNT
NAVER_WORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NAVER_WORKS_BOT_ID=YOUR_NAVER_WORKS_BOT_ID
NAVER_WORKS_KPI_CHANNEL_ID=YOUR_WORKS_KPI_CHANNEL_ID
NAVER_WORKS_SCHEDULE_CHANNEL_ID=YOUR_WORKS_SCHEDULE_CHANNEL_ID
